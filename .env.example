# Firebase Service Account JSON (full JSON as a single line string)
# Generate from Firebase Console > Project Settings > Service Accounts > Generate New Private Key
FIREBASE_SERVICE_ACCOUNT=

# Timezone for date formatting (default: UTC)
# Examples: UTC, America/New_York, Europe/London, Asia/Tokyo
APP_TIMEZONE=UTC

# CORS allowed origin for production frontend
# Example: https://your-frontend-domain.com
ALLOWED_ORIGIN=*